# ─────────────────────────────────────────────────────────────
# Atlas environment variables — TEMPLATE
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Supabase project values: Supabase Dashboard → Project Settings → API
# Safe to expose to the browser (NEXT_PUBLIC_ prefix). The anon key is
# meant to be public; security is enforced by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY secret. Bypasses Row Level Security — treat like a root password.
# No NEXT_PUBLIC_ prefix, so it is never bundled into client code.
# Used only by trusted server jobs (e.g. the follow-up reminder cron in Phase 2).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app. Used to build auth redirect URLs.
# Set to the deployed URL in production (e.g. https://atlas.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
